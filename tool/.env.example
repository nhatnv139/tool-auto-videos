# API keys — copy file nay thanh .env va dien key cua ban (KHONG commit .env)
# PIXABAY: dang ky pixabay.com -> API key (free)
# PEXELS: dang ky pexels.com -> API key (free)
PIXABAY_API_KEY=
PEXELS_API_KEY=

# Optional:
# ELEVENLABS_API_KEY=          # giong doc tu nhien hon (tra phi)
# YT_SCRIPT_PATH=              # duong dan yt-script/local/app.py (align tu dong)
# GIT_BASH=C:\Program Files\Git\bin\bash.exe

# COVERR: dang ky coverr.co -> profile/api -> Create (demo: 50 request/gio)
COVERR_API_KEY=
# UNSPLASH: unsplash.com/oauth/applications -> Access Key (demo: 50 request/gio)
# Dieu khoan bat buoc ghi ten tac gia - tool tu ghi vao build/photo-credits.json
UNSPLASH_ACCESS_KEY=
